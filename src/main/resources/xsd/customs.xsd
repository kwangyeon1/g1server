<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:annotation>
		<xs:appinfo>Air/Ocean Inbound 0.1</xs:appinfo>
		<xs:documentation>ExpressWeb Air Inbound Interface</xs:documentation>
	</xs:annotation>
	<xs:element name="root">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="AccessIdentifier">
					<xs:complexType>
						<xs:all>
							<xs:element name="SenderIdentifier">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="20"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="ReceiverIdentifier">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="5"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="AccessKey">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="64"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="CustomsInfo" maxOccurs="1000">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="MBLNo">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="20"/>
										<xs:pattern value="[A-Z0-9]*"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="HBLNo">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="20"/>
										<xs:pattern value="[A-Z0-9]*"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="CStatus">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="5"/>
										<xs:maxLength value="5"/>
										<xs:pattern value="[Hh]{1}[Tt]{1}[Ff]{1}[1-5]{1}[0]{1}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="CustomsAcceptDate" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="\d{4}-\d{2}-\d{2}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="ExchangeRate_Amount">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{1,10}\.[0-9]{1,2}|[0-9]{1,12}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Fare_Amount">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{1,10}\.[0-9]{1,2}|[0-9]{1,12}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="CIF_Amount">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{1,10}\.[0-9]{1,2}|[0-9]{1,12}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Duty_Amount">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{1,10}\.[0-9]{1,2}|[0-9]{1,12}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="SpecialExcise_Amount">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{1,10}\.[0-9]{1,2}|[0-9]{1,12}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Liquor_Amount">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{1,10}\.[0-9]{1,2}|[0-9]{1,12}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Education_Amount">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{1,10}\.[0-9]{1,2}|[0-9]{1,12}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="RuralDevelopment_Amount">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{1,10}\.[0-9]{1,2}|[0-9]{1,12}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Vat_Amount">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{1,10}\.[0-9]{1,2}|[0-9]{1,12}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
