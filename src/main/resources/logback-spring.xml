<!--         <appender-ref ref="Console"/> -->
<!--         <appender-ref ref="File"/> -->
<!--         <appender-ref ref="Error"/> -->
<!-- 	</logger> -->
	
    <root level="OFF">
		<appender-ref ref="Console"/>
	</root>
	
</configuration>